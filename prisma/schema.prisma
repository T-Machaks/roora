// Prisma schema for the Roora maroora/lobola event PWA.
// Kept provider-portable (no sqlite-only features) so migrating to
// Postgres later is just a datasource + DATABASE_URL swap.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  SUPERADMIN
  ADMIN
  APPROVED_GUEST
  PENDING_GUEST
}

enum InvitationStatus {
  PENDING
  REDEEMED
  REVOKED
  EXPIRED
}

enum RsvpStatus {
  NO_RESPONSE
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

enum ProgramType {
  MAIN
  AFTER_PARTY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum ShareScope {
  SINGLE_MEDIA
  ALBUM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  guestHandle  String   @unique
  passwordHash String
  role         Role     @default(PENDING_GUEST)
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invitationRedeemed Invitation?        @relation("RedeemedBy")
  invitationsCreated Invitation[]       @relation("CreatedBy")
  rsvp               Rsvp?
  media              Media[]
  comments           Comment[]
  moderationLogs     ModerationLog[]    @relation("Actor")
  shareLinks         ShareLink[]
  pushSubscriptions  PushSubscription[]
}

model Invitation {
  id        String            @id @default(cuid())
  code      String            @unique
  token     String            @unique
  guestName String?
  maxGuests Int               @default(1)
  note      String?
  status    InvitationStatus  @default(PENDING)
  roleGrant Role              @default(APPROVED_GUEST)
  expiresAt DateTime?

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  redeemedById String? @unique
  redeemedBy   User?   @relation("RedeemedBy", fields: [redeemedById], references: [id])
  redeemedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Rsvp {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id])
  status      RsvpStatus @default(NO_RESPONSE)
  guestCount  Int        @default(1)
  notes       String?
  respondedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ScheduleItem {
  id          String      @id @default(cuid())
  programType ProgramType
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([programType, order])
}

model EventSettings {
  id String @id @default("default")

  brideName String
  groomName String
  eventDate DateTime

  mainVenueName    String?
  mainVenueAddress String?
  mainVenueIsTBA   Boolean   @default(true)
  mainStartTime    DateTime?
  mainEndTime      DateTime?

  afterVenueName    String?
  afterVenueAddress String?
  afterVenueIsTBA   Boolean   @default(true)
  afterStartTime    DateTime?
  afterEndTime      DateTime?

  dressCode String

  themePrimaryColor   String @default("#5C3A21")
  themeSecondaryColor String @default("#EDE0D4")
  themeName           String @default("groom")

  rsvpDeadline DateTime?

  updatedAt DateTime @updatedAt
}

model ContactPerson {
  id    String  @id @default(cuid())
  name  String
  role  String
  phone String?
  email String?
  order Int     @default(0)
}

model Media {
  id           String            @id @default(cuid())
  uploaderId   String
  uploader     User              @relation(fields: [uploaderId], references: [id])
  type         MediaType
  mimeType     String
  fileName     String
  originalName String
  path         String
  sizeBytes    Int
  width        Int?
  height       Int?
  caption      String?
  status       ModerationStatus  @default(PENDING)
  moderatedById String?
  moderatedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  comments   Comment[]
  shareLinks ShareLink[]

  @@index([status])
  @@index([uploaderId])
}

model Comment {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mediaId])
}

model ModerationLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("Actor", fields: [actorId], references: [id])
  targetType String
  targetId   String
  action     String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

model ShareLink {
  id        String     @id @default(cuid())
  token     String     @unique
  scope     ShareScope
  mediaId   String?
  media     Media?     @relation(fields: [mediaId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  expiresAt DateTime?
  maxViews  Int?
  viewCount Int       @default(0)
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
