# Copy this file to .env and fill in real values before running the app.

# --- Database (Prisma + SQLite, self-hosted) ---
DATABASE_URL="file:./prisma/dev.db"

# --- Sessions ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-32-plus-char-random-string"

# --- Uploaded media storage (local disk, self-hosted) ---
UPLOAD_DIR="./uploads"
MAX_UPLOAD_IMAGE_MB=15
MAX_UPLOAD_VIDEO_MB=200

# --- App ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# --- Bootstrap defaults (only used before EventSettings is seeded; edit live via /admin/settings after) ---
EVENT_DATE="2026-10-24"
THEME_PRIMARY_COLOR="#5C3A21"
THEME_SECONDARY_COLOR="#EDE0D4"

# --- Seed: first superadmin account (created by `npm run seed`) ---
SEED_SUPERADMIN_NAME="Superadmin"
SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="change-me-now"

# --- Push notifications (structure only; sending is not implemented yet) ---
ENABLE_PUSH="false"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
